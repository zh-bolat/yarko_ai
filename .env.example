# .env.example — скопируйте в .env и заполните

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Telegram Bot (получить через @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/api/telegram

# Пароль для доступа к демо (оставьте пустым чтобы отключить)
APP_PASSWORD=yarko2026

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# Склейка сообщений Telegram
MESSAGE_BUFFER_TIMEOUT_SEC=30
MESSAGE_BUFFER_MAX_MESSAGES=10
MESSAGE_BUFFER_TTL_SEC=3600

# Общее
DEBUG=false
PORT=8000
HOST=0.0.0.0
MAX_MESSAGE_LENGTH=5000
MAX_BATCH_SIZE=20
